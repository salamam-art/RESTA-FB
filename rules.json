          ".validate": "newData.hasChildren(['from', 'text', 'ts']) && newData.child('from').val() === auth.token.email.toLowerCase().replace('.', ',') && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 500 && newData.child('ts').isNumber()",
