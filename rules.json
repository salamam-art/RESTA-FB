          ".validate": "newData.hasChildren(['from', 'ts']) && newData.child('from').val() === auth.token.email.toLowerCase().replace('.', ',') && newData.child('ts').isNumber() && (!newData.child('text').exists() || (newData.child('text').isString() && newData.child('text').val().length <= 80))",
